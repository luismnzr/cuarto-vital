<div data-controller="dialog" data-dialog-id-value="<%= @id %>">
  <% if trigger? %>
    <div data-action="click->dialog#open">
      <%= trigger %>
    </div>
  <% end %>

  <template data-dialog-target="template">
    <div id="<%= @id %>" class="fixed inset-0 z-50 flex items-center justify-center" data-action="keydown.esc->dialog#close">
      <div class="fixed inset-0 bg-black/50" data-action="click->dialog#close"></div>
      <div class="relative z-50 w-full <%= size_class %> mx-4 rounded-[var(--radius-lg)] bg-[var(--color-background)] shadow-[var(--shadow-lg)] border border-[var(--color-border)]">
        <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--color-border)]">
          <h2 class="text-lg font-semibold"><%= title %></h2>
          <button type="button" class="text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" data-action="dialog#close">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
        </div>
        <div class="px-6 py-4">
          <%= content %>
        </div>
        <% if footer? %>
          <div class="flex items-center justify-end gap-2 px-6 py-4 border-t border-[var(--color-border)]">
            <%= footer %>
          </div>
        <% end %>
      </div>
    </div>
  </template>
</div>

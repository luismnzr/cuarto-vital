<% content_for(:title) { "Billing" } %>

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-bold">Billing & Payments</h1>
    <% if current_user.stripe_customer_id.present? %>
      <%= button_to customer_portal_path, method: :post,
            class: "inline-flex items-center px-4 py-2 text-sm font-medium text-[var(--color-foreground)] border border-[var(--color-border)] rounded-lg hover:bg-[var(--color-muted)] transition-colors cursor-pointer" do %>
        Manage Payment Methods
      <% end %>
    <% end %>
  </div>

  <% if @payments.any? %>
    <div class="space-y-2">
      <% @payments.each do |payment| %>
        <div class="flex items-center justify-between py-3 border-b border-[var(--color-border)]">
          <div>
            <p class="font-medium"><%= payment.description || "Payment" %></p>
            <p class="text-sm text-[var(--color-muted-foreground)]"><%= payment.created_at.strftime("%B %d, %Y") %></p>
          </div>
          <div class="text-right">
            <p class="font-medium">$<%= number_with_precision(payment.amount, precision: 2) %> <%= payment.currency.upcase %></p>
            <%= render Ui::BadgeComponent.new(text: payment.status.titleize, variant: payment.status == "succeeded" ? :success : :secondary) %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-[var(--color-muted-foreground)]">No payment history yet.</p>
  <% end %>
</div>

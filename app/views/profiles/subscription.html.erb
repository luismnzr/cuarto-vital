<% content_for(:title) { "My Subscription" } %>

<div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-8">
  <h1 class="text-2xl font-bold mb-8">My Subscription</h1>

  <% if @user_subscription&.active? %>
    <%= render Ui::CardComponent.new do %>
      <div class="flex items-start justify-between">
        <div>
          <h2 class="text-lg font-semibold"><%= @user_subscription.subscription_plan.name %></h2>
          <p class="text-[var(--color-muted-foreground)]">Unlimited classes</p>
        </div>
        <%= render Ui::BadgeComponent.new(text: "Active", variant: :success) %>
      </div>
      <div class="grid grid-cols-2 gap-4 mt-6">
        <div>
          <p class="text-sm text-[var(--color-muted-foreground)]">Price</p>
          <p class="font-medium">$<%= number_with_precision(@user_subscription.subscription_plan.price, precision: 0) %> MXN/<%= @user_subscription.subscription_plan.interval %></p>
        </div>
        <div>
          <p class="text-sm text-[var(--color-muted-foreground)]">Current Period Ends</p>
          <p class="font-medium"><%= @user_subscription.current_period_end&.strftime("%B %d, %Y") || "N/A" %></p>
        </div>
      </div>
      <div class="mt-6 flex gap-3">
        <% if current_user.stripe_customer_id.present? %>
          <%= button_to customer_portal_path, method: :post,
                class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors shadow-sm cursor-pointer" do %>
            Manage Subscription
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%= render Ui::CardComponent.new do %>
      <div class="text-center py-8">
        <p class="text-[var(--color-muted-foreground)] mb-4">You don't have an active subscription.</p>
        <%= render Ui::ButtonComponent.new(href: packages_path) do %>View Subscription Plans<% end %>
      </div>
    <% end %>
  <% end %>
</div>

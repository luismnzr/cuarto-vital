<% content_for(:title) { "My Profile" } %>

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left sidebar -->
    <div class="space-y-6">
      <!-- Profile card -->
      <div class="bg-white rounded-2xl border border-[var(--color-border)] overflow-hidden">
        <div class="h-20 bg-gradient-to-r from-[var(--color-primary)] to-[var(--color-accent)]"></div>
        <div class="px-6 pb-6 -mt-10">
          <div class="h-20 w-20 rounded-2xl bg-[var(--color-primary)] flex items-center justify-center border-4 border-white shadow-md">
            <span class="text-2xl font-bold text-white"><%= @user.first_name[0] %><%= @user.last_name[0] %></span>
          </div>
          <h2 class="mt-3 text-lg font-bold text-[var(--color-foreground)]"><%= @user.full_name %></h2>
          <p class="text-sm text-[var(--color-muted-foreground)]"><%= @user.email %></p>
          <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Member since <%= @user.created_at.strftime("%B %Y") %></p>
          <div class="mt-4">
            <%= link_to edit_user_registration_path, class: "w-full inline-flex items-center justify-center h-9 px-4 text-sm font-medium text-[var(--color-foreground)] border border-[var(--color-border)] rounded-lg hover:bg-[var(--color-muted)] transition-colors" do %>
              <svg class="h-3.5 w-3.5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
              Edit Profile
            <% end %>
          </div>
        </div>
      </div>

      <!-- Membership card -->
      <div class="bg-gradient-to-br from-[var(--color-primary)] to-[var(--color-accent)] rounded-2xl p-6 text-white">
        <div class="flex items-center justify-between mb-4">
          <span class="text-sm font-medium text-white/70">Current Plan</span>
          <svg class="h-5 w-5 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
        </div>
        <% if @user.has_active_subscription? %>
          <p class="text-xl font-bold"><%= @user.user_subscription.subscription_plan.name %></p>
          <p class="text-sm text-white/70 mt-1">Unlimited classes</p>
        <% elsif @user.active_package %>
          <p class="text-xl font-bold"><%= @user.active_package.package.name %></p>
          <div class="mt-3 flex items-center gap-4">
            <div>
              <p class="text-xs text-white/60">Credits Left</p>
              <p class="text-lg font-bold"><%= @user.active_package.credits_remaining %></p>
            </div>
            <div>
              <p class="text-xs text-white/60">Expires</p>
              <p class="text-sm font-medium"><%= @user.active_package.expires_at.strftime("%b %d, %Y") %></p>
            </div>
          </div>
        <% else %>
          <p class="text-xl font-bold">No active plan</p>
          <p class="text-sm text-white/70 mt-1"><%= link_to "Browse packages →", packages_path, class: "text-white underline" %></p>
        <% end %>
      </div>

      <!-- Quick links -->
      <nav class="bg-white rounded-2xl border border-[var(--color-border)] overflow-hidden">
        <%= link_to profile_classes_path, class: "flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-[var(--color-foreground)] hover:bg-[var(--color-muted)] transition-colors border-b border-[var(--color-border)]" do %>
          <svg class="h-4 w-4 text-[var(--color-muted-foreground)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          My Classes
        <% end %>
        <%= link_to profile_package_path, class: "flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-[var(--color-foreground)] hover:bg-[var(--color-muted)] transition-colors border-b border-[var(--color-border)]" do %>
          <svg class="h-4 w-4 text-[var(--color-muted-foreground)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
          Package Details
        <% end %>
        <%= link_to profile_waitlists_path, class: "flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-[var(--color-foreground)] hover:bg-[var(--color-muted)] transition-colors border-b border-[var(--color-border)]" do %>
          <svg class="h-4 w-4 text-[var(--color-muted-foreground)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Waitlists
        <% end %>
        <%= link_to profile_billing_path, class: "flex items-center gap-3 px-5 py-3.5 text-sm font-medium text-[var(--color-foreground)] hover:bg-[var(--color-muted)] transition-colors" do %>
          <svg class="h-4 w-4 text-[var(--color-muted-foreground)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          Billing History
        <% end %>
      </nav>
    </div>

    <!-- Main content -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Stats row -->
      <div class="grid grid-cols-3 gap-4">
        <div class="bg-white rounded-xl border border-[var(--color-border)] p-4 text-center">
          <p class="text-2xl font-bold text-[var(--color-primary)]"><%= @user.has_active_subscription? ? "∞" : (@user.active_package&.credits_remaining || 0) %></p>
          <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Credits Left</p>
        </div>
        <div class="bg-white rounded-xl border border-[var(--color-border)] p-4 text-center">
          <p class="text-2xl font-bold text-[var(--color-primary)]"><%= @user.reservations.confirmed.joins(:studio_class).where("studio_classes.date >= ?", Date.current).count %></p>
          <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Upcoming</p>
        </div>
        <div class="bg-white rounded-xl border border-[var(--color-border)] p-4 text-center">
          <p class="text-2xl font-bold text-[var(--color-primary)]"><%= @user.reservations.where(status: "completed").count %></p>
          <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Completed</p>
        </div>
      </div>

      <!-- Upcoming classes -->
      <div class="bg-white rounded-2xl border border-[var(--color-border)]">
        <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--color-border)]">
          <h3 class="font-semibold text-[var(--color-foreground)]">Upcoming Classes</h3>
          <%= link_to "View all", profile_classes_path, class: "text-sm text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] font-medium" %>
        </div>
        <% upcoming = @user.reservations.confirmed.joins(:studio_class).where("studio_classes.date >= ?", Date.current).includes(studio_class: [:class_template, :teacher]).order("studio_classes.date ASC, studio_classes.start_time ASC").limit(5) %>
        <% if upcoming.any? %>
          <div class="divide-y divide-[var(--color-border)]">
            <% upcoming.each do |reservation| %>
              <% sc = reservation.studio_class %>
              <div class="flex items-center gap-4 px-6 py-4">
                <div class="flex-shrink-0 h-12 w-12 rounded-xl bg-[var(--color-primary)]/10 flex items-center justify-center">
                  <span class="text-xs font-bold text-[var(--color-primary)]"><%= sc.date.strftime("%b") %><br><%= sc.date.day %></span>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="font-medium text-[var(--color-foreground)] text-sm truncate"><%= sc.name %></p>
                  <p class="text-xs text-[var(--color-muted-foreground)]"><%= sc.start_time.strftime("%l:%M %p").strip %> &middot; <%= sc.teacher.full_name %></p>
                </div>
                <span class="flex-shrink-0 px-2 py-0.5 text-xs font-medium rounded-full bg-emerald-50 text-emerald-700">Confirmed</span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="px-6 py-12 text-center">
            <p class="text-sm text-[var(--color-muted-foreground)]">No upcoming classes</p>
            <%= link_to "Browse schedule", classes_path, class: "mt-2 inline-flex text-sm font-medium text-[var(--color-primary)] hover:text-[var(--color-primary-hover)]" %>
          </div>
        <% end %>
      </div>

      <!-- Recent activity -->
      <div class="bg-white rounded-2xl border border-[var(--color-border)]">
        <div class="px-6 py-4 border-b border-[var(--color-border)]">
          <h3 class="font-semibold text-[var(--color-foreground)]">Recent Activity</h3>
        </div>
        <% recent = @user.reservations.where(status: ["completed", "cancelled", "no_show"]).joins(:studio_class).includes(studio_class: [:class_template]).order("studio_classes.date DESC").limit(5) %>
        <% if recent.any? %>
          <div class="divide-y divide-[var(--color-border)]">
            <% recent.each do |reservation| %>
              <% sc = reservation.studio_class %>
              <div class="flex items-center gap-4 px-6 py-4">
                <div class="flex-shrink-0 h-10 w-10 rounded-lg flex items-center justify-center
                            <%= reservation.status == 'completed' ? 'bg-emerald-50' : 'bg-red-50' %>">
                  <% if reservation.status == 'completed' %>
                    <svg class="h-4 w-4 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                  <% else %>
                    <svg class="h-4 w-4 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-[var(--color-foreground)] truncate"><%= sc.name %></p>
                  <p class="text-xs text-[var(--color-muted-foreground)]"><%= sc.date.strftime("%b %d, %Y") %></p>
                </div>
                <span class="text-xs text-[var(--color-muted-foreground)] capitalize"><%= reservation.status %></span>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="px-6 py-12 text-center">
            <p class="text-sm text-[var(--color-muted-foreground)]">No activity yet. Book your first class!</p>
          </div>
        <% end %>
      </div>

      <!-- Recent Purchases -->
      <% recent_payments = @user.payments.recent.limit(5) %>
      <% if recent_payments.any? %>
        <div class="bg-white rounded-2xl border border-[var(--color-border)]">
          <div class="flex items-center justify-between px-6 py-4 border-b border-[var(--color-border)]">
            <h3 class="font-semibold text-[var(--color-foreground)]">Recent Purchases</h3>
            <%= link_to "View all", profile_billing_path, class: "text-sm text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] font-medium" %>
          </div>
          <div class="divide-y divide-[var(--color-border)]">
            <% recent_payments.each do |payment| %>
              <div class="flex items-center gap-4 px-6 py-4">
                <div class="flex-shrink-0 h-10 w-10 rounded-lg flex items-center justify-center
                            <%= payment.status == 'succeeded' ? 'bg-emerald-50' : 'bg-gray-50' %>">
                  <svg class="h-4 w-4 <%= payment.status == 'succeeded' ? 'text-emerald-600' : 'text-gray-400' %>"
                       fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p class="text-sm font-medium text-[var(--color-foreground)] truncate"><%= payment.description.presence || "Payment" %></p>
                  <p class="text-xs text-[var(--color-muted-foreground)]"><%= payment.created_at.strftime("%b %d, %Y") %></p>
                </div>
                <div class="text-right flex-shrink-0">
                  <p class="text-sm font-semibold">$<%= number_with_precision(payment.amount, precision: 2) %> <%= payment.currency.upcase %></p>
                  <span class="text-xs <%= payment.status == 'succeeded' ? 'text-emerald-600' : 'text-[var(--color-muted-foreground)]' %> capitalize">
                    <%= payment.status %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

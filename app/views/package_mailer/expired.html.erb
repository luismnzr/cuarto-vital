<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0f172a;">Your Package Has Expired</h1>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.5;">Hi <%= @user.first_name %>, your class package has expired.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fef2f2; border-radius: 8px; border: 1px solid #fecaca; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <%= email_detail_row("Package", @package.name) %>
        <%= email_detail_row("Unused Credits", "#{@user_package.credits_remaining} lost") %>
        <%= email_detail_row("Expired On", format_date(@user_package.expires_at.to_date)) %>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 0 0 0 0; font-size: 14px; color: #64748b; line-height: 1.5;">Purchase a new package to continue booking classes.</p>

<%= email_button("View Packages", packages_url) %>

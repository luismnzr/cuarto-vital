<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0f172a;">Package Purchased</h1>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.5;">Hi <%= @user.first_name %>, thank you for your purchase!</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <%= email_detail_row("Package", @package.name) %>
        <%= email_detail_row("Price", format_currency(@package.price)) %>
        <%= email_detail_row("Credits", "#{@user_package.credits_remaining} classes") %>
        <%= email_detail_row("Purchased", format_date(@user_package.purchased_at.to_date)) %>
        <%= email_detail_row("Expires", format_date(@user_package.expires_at.to_date)) %>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 0 0 0 0; font-size: 14px; color: #64748b; line-height: 1.5;">You're ready to start booking classes. See you in the studio!</p>

<%= email_button("Browse Classes", classes_url) %>

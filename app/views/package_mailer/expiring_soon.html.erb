<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0f172a;">Your Package Expires Soon</h1>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.5;">Hi <%= @user.first_name %>, your class package is expiring in 3 days.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #fef9ee; border-radius: 8px; border: 1px solid #fde68a; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <%= email_detail_row("Package", @package.name) %>
        <%= email_detail_row("Remaining", "#{@user_package.credits_remaining} credits") %>
        <%= email_detail_row("Expires", format_date(@user_package.expires_at.to_date)) %>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 0 0 0 0; font-size: 14px; color: #64748b; line-height: 1.5;">Use your remaining credits before they expire, or renew your package to keep them going.</p>

<%= email_button("Renew Package", packages_url) %>

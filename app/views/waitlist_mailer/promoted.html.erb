<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0f172a;">You're In!</h1>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.5;">Hi <%= @user.first_name %>, great news — a spot opened up and you've been moved off the waitlist!</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f0fdf4; border-radius: 8px; border: 1px solid #bbf7d0; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <%= email_detail_row("Class", @studio_class.name) %>
        <%= email_detail_row("Date", format_class_date(@studio_class)) %>
        <%= email_detail_row("Time", format_class_time(@studio_class)) %>
        <%= email_detail_row("Teacher", @studio_class.teacher.full_name) %>
        <%= email_detail_row("Status", "Confirmed") %>
      </table>
    </td>
  </tr>
</table>

<p style="margin: 0 0 0 0; font-size: 14px; color: #64748b; line-height: 1.5;">A class credit has been deducted from your package. See you in class!</p>

<%= email_button("View My Classes", profile_classes_url) %>

<%= link_to "&larr; Back to Classes".html_safe, teacher_classes_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] mb-4 inline-block" %>

<div class="max-w-3xl">
  <!-- Class header -->
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h1 class="text-xl font-bold"><%= @studio_class.name %></h1>
        <p class="text-sm text-[var(--color-muted-foreground)] mt-1">
          <%= @studio_class.date.strftime("%A, %B %d, %Y") %> &middot;
          <%= @studio_class.start_time.strftime("%l:%M %p").strip %> — <%= @studio_class.end_time.strftime("%l:%M %p").strip %>
        </p>
      </div>
      <div class="text-right">
        <p class="text-2xl font-bold"><%= @studio_class.confirmed_count %>/<%= @studio_class.capacity %></p>
        <p class="text-xs text-[var(--color-muted-foreground)]">registered</p>
      </div>
    </div>
    <div class="flex gap-3 text-sm">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[var(--color-primary)]/10 text-[var(--color-primary)]"><%= @studio_class.style %></span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= @studio_class.level.titleize %></span>
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= @studio_class.duration %> min</span>
    </div>
  </div>

  <!-- Confirmed students -->
  <div class="bg-white rounded-xl border border-[var(--color-border)] mb-6">
    <div class="px-5 py-4 border-b border-[var(--color-border)]">
      <h2 class="font-semibold">Confirmed Students (<%= @reservations.size %>)</h2>
    </div>
    <% if @reservations.any? %>
      <div class="divide-y divide-[var(--color-border)]">
        <% @reservations.each do |r| %>
          <div class="flex items-center gap-3 px-5 py-3">
            <%= render Ui::AvatarComponent.new(name: r.user.full_name, size: :sm) %>
            <div class="flex-1">
              <p class="text-sm font-medium"><%= r.user.full_name %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]"><%= r.user.email %></p>
            </div>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Confirmed</span>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-5 py-8 text-center">
        <p class="text-sm text-[var(--color-muted-foreground)]">No confirmed students yet</p>
      </div>
    <% end %>
  </div>

  <!-- Waitlist -->
  <% if @waitlist_entries.any? %>
    <div class="bg-white rounded-xl border border-[var(--color-border)]">
      <div class="px-5 py-4 border-b border-[var(--color-border)]">
        <h2 class="font-semibold">Waitlist (<%= @waitlist_entries.size %>)</h2>
      </div>
      <div class="divide-y divide-[var(--color-border)]">
        <% @waitlist_entries.each_with_index do |w, i| %>
          <div class="flex items-center gap-3 px-5 py-3">
            <span class="text-xs font-bold text-[var(--color-muted-foreground)] w-5 text-center"><%= i + 1 %></span>
            <%= render Ui::AvatarComponent.new(name: w.user.full_name, size: :sm) %>
            <div class="flex-1">
              <p class="text-sm font-medium"><%= w.user.full_name %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]"><%= w.user.email %></p>
            </div>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700">Waitlisted</span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

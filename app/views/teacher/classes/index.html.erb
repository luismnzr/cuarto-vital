<div class="mb-6">
  <h1 class="text-2xl font-bold">My Classes</h1>
  <p class="text-[var(--color-muted-foreground)] mt-1">All your scheduled classes</p>
</div>

<% if @studio_classes.any? %>
  <div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
    <div class="divide-y divide-[var(--color-border)]">
      <% @studio_classes.each do |sc| %>
        <%= link_to teacher_class_path(sc), class: "flex items-center gap-4 px-5 py-4 hover:bg-[var(--color-muted)]/30 transition-colors" do %>
          <div class="flex-shrink-0 text-center w-14">
            <p class="text-xs font-medium text-[var(--color-muted-foreground)] uppercase"><%= sc.date.strftime("%b") %></p>
            <p class="text-lg font-bold text-[var(--color-foreground)]"><%= sc.date.strftime("%d") %></p>
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-[var(--color-foreground)] truncate"><%= sc.name %></p>
            <p class="text-xs text-[var(--color-muted-foreground)]">
              <%= sc.date.strftime("%A") %> &middot; <%= sc.start_time.strftime("%l:%M %p").strip %> &middot; <%= sc.duration %> min
            </p>
          </div>
          <div class="text-right">
            <p class="text-sm font-semibold text-[var(--color-foreground)]"><%= sc.confirmed_count %>/<%= sc.capacity %></p>
            <p class="text-xs text-[var(--color-muted-foreground)]">registered</p>
          </div>
          <svg class="h-4 w-4 text-[var(--color-muted-foreground)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
        <% end %>
      <% end %>
    </div>
  </div>
<% else %>
  <div class="bg-white rounded-xl border border-[var(--color-border)] px-5 py-12 text-center">
    <svg class="mx-auto h-10 w-10 text-[var(--color-muted-foreground)]/40 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    <p class="text-sm text-[var(--color-muted-foreground)]">No scheduled classes yet</p>
  </div>
<% end %>

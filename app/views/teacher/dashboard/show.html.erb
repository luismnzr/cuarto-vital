<%
  day_names = %w[Sunday Monday Tuesday Wednesday Thursday Friday Saturday]
%>

<!-- Welcome header -->
<div class="mb-8">
  <h1 class="text-2xl font-bold">Welcome back, <%= current_user.first_name %></h1>
  <p class="text-[var(--color-muted-foreground)] mt-1">Here's what's happening with your classes</p>
</div>

<!-- Stats cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Classes This Month</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @classes_this_month %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-gray-100 flex items-center justify-center">
        <svg class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Total Students</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @total_students %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-gray-100 flex items-center justify-center">
        <svg class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Hours Taught</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= number_with_precision(@hours_taught, precision: 1, strip_insignificant_zeros: true) %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-emerald-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Attendance Rate</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @attendance_rate %>%</p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-amber-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      </div>
    </div>
  </div>
</div>

<!-- Main content: Upcoming Classes + Weekly Schedule -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <!-- Upcoming Classes (2/3 width) -->
  <div class="lg:col-span-2 bg-white rounded-xl border border-[var(--color-border)]">
    <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--color-border)]">
      <h2 class="font-semibold text-[var(--color-foreground)]">Upcoming Classes</h2>
      <%= link_to "View all", teacher_classes_path, class: "text-sm text-[var(--color-primary)] font-medium hover:text-[var(--color-primary-hover)]" %>
    </div>

    <% if @upcoming_classes.any? %>
      <div class="divide-y divide-[var(--color-border)]">
        <% @upcoming_classes.each do |sc| %>
          <%= link_to teacher_class_path(sc), class: "flex items-center gap-4 px-5 py-4 hover:bg-[var(--color-muted)]/30 transition-colors" do %>
            <div class="flex-shrink-0 text-center w-14">
              <p class="text-xs font-medium text-[var(--color-muted-foreground)] uppercase"><%= sc.date.strftime("%b") %></p>
              <p class="text-lg font-bold text-[var(--color-foreground)]"><%= sc.date.strftime("%d") %></p>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-[var(--color-foreground)] truncate"><%= sc.name %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]">
                <%= sc.date.strftime("%A") %> &middot; <%= sc.start_time.strftime("%l:%M %p").strip %> &middot; <%= sc.duration %> min
              </p>
            </div>
            <div class="flex items-center gap-3">
              <%# Stacked avatars for confirmed students %>
              <div class="flex -space-x-2">
                <% sc.reservations.select { |r| r.status == "confirmed" }.first(3).each do |r| %>
                  <%= render Ui::AvatarComponent.new(name: r.user.full_name, size: :sm) %>
                <% end %>
                <% extra = sc.confirmed_count - 3 %>
                <% if extra > 0 %>
                  <div class="h-8 w-8 rounded-full bg-[var(--color-muted)] flex items-center justify-center text-xs font-medium text-[var(--color-muted-foreground)] ring-2 ring-white">
                    +<%= extra %>
                  </div>
                <% end %>
              </div>
              <div class="text-right">
                <p class="text-sm font-semibold text-[var(--color-foreground)]"><%= sc.confirmed_count %>/<%= sc.capacity %></p>
                <p class="text-xs text-[var(--color-muted-foreground)]">registered</p>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center">
        <svg class="mx-auto h-10 w-10 text-[var(--color-muted-foreground)]/40 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <p class="text-sm text-[var(--color-muted-foreground)]">No upcoming classes scheduled</p>
      </div>
    <% end %>
  </div>

  <!-- Weekly Schedule (1/3 width) -->
  <div class="bg-white rounded-xl border border-[var(--color-border)]">
    <div class="px-5 py-4 border-b border-[var(--color-border)]">
      <h2 class="font-semibold text-[var(--color-foreground)]">Weekly Schedule</h2>
    </div>

    <% if @weekly_schedule.any? %>
      <div class="divide-y divide-[var(--color-border)]">
        <% @weekly_schedule.group_by(&:day_of_week).each do |dow, templates| %>
          <div class="px-5 py-3">
            <p class="text-xs font-semibold text-[var(--color-muted-foreground)] uppercase tracking-wide mb-2"><%= day_names[dow] %></p>
            <% templates.each do |tmpl| %>
              <div class="flex items-center justify-between py-1.5">
                <div>
                  <p class="text-sm font-medium text-[var(--color-foreground)]"><%= tmpl.name %></p>
                  <p class="text-xs text-[var(--color-muted-foreground)]"><%= tmpl.style %> &middot; <%= tmpl.level.titleize %></p>
                </div>
                <span class="text-xs font-medium text-[var(--color-muted-foreground)]"><%= tmpl.default_start_time&.strftime("%l:%M %p")&.strip %></span>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-5 py-12 text-center">
        <p class="text-sm text-[var(--color-muted-foreground)]">No recurring schedule set</p>
      </div>
    <% end %>
  </div>
</div>

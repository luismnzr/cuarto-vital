<div class="max-w-2xl">
  <%= link_to "&larr; Back to Profile".html_safe, teacher_profile_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] mb-4 inline-block" %>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-6">
    <h2 class="text-lg font-semibold mb-6">Edit Profile</h2>

    <%= form_with(model: current_user, url: teacher_profile_path, method: :patch, class: "space-y-5") do |f| %>
      <% if current_user.errors.any? %>
        <div class="p-4 rounded-lg bg-red-50 text-red-700 text-sm">
          <p class="font-medium mb-1"><%= pluralize(current_user.errors.count, "error") %> prevented saving:</p>
          <ul class="list-disc pl-5 space-y-1">
            <% current_user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- Photo -->
      <div>
        <label class="block text-sm font-medium text-[var(--color-foreground)] mb-2">Profile Photo</label>
        <div class="flex items-center gap-4">
          <% if current_user.photo.attached? %>
            <%= render Ui::AvatarComponent.new(
              name: current_user.full_name,
              src: url_for(current_user.photo.variant(resize_to_fill: [160, 160])),
              size: :lg
            ) %>
          <% else %>
            <%= render Ui::AvatarComponent.new(name: current_user.full_name, size: :lg) %>
          <% end %>
          <div>
            <%= f.file_field :photo, accept: "image/png,image/jpeg,image/webp",
              class: "block w-full text-sm text-[var(--color-muted-foreground)] file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-[var(--color-primary)] file:text-white hover:file:bg-[var(--color-primary-hover)] file:cursor-pointer" %>
            <p class="text-xs text-[var(--color-muted-foreground)] mt-1">PNG, JPG or WebP. Max 5MB.</p>
          </div>
        </div>
      </div>

      <!-- Name -->
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :first_name, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
          <%= f.text_field :first_name, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
        </div>
        <div>
          <%= f.label :last_name, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
          <%= f.text_field :last_name, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
        </div>
      </div>

      <!-- Phone -->
      <div>
        <%= f.label :phone, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
        <%= f.text_field :phone, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      </div>

      <!-- Styles Taught -->
      <div>
        <%= f.label :styles_taught, "Styles I Teach", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
        <%= f.text_field :styles_taught, placeholder: "e.g. Vinyasa, Hatha, Yin", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
        <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Separate styles with commas</p>
      </div>

      <!-- Bio -->
      <div>
        <%= f.label :bio, "About Me", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
        <%= f.text_area :bio, rows: 4, placeholder: "Tell students a bit about yourself and your teaching style...", class: "w-full px-3 py-2 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)] resize-none" %>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <%= f.submit "Save Changes", class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" %>
        <%= link_to "Cancel", teacher_profile_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
      </div>
    <% end %>
  </div>
</div>

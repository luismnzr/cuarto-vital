<% content_for(:title) { "Account Settings" } %>

<div class="mx-auto max-w-2xl px-4 py-8">
  <h1 class="text-2xl font-bold mb-6">Account Settings</h1>

  <%= render Ui::CardComponent.new do %>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
      <% if resource.errors.any? %>
        <%= render Ui::AlertComponent.new(variant: :destructive, title: "Please fix the following errors:") do %>
          <ul class="list-disc list-inside mt-1">
            <% resource.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <div>
        <h2 class="text-lg font-semibold mb-4">Personal Information</h2>
        <div class="grid grid-cols-2 gap-4">
          <%= render Ui::InputComponent.new(
            name: "user[first_name]",
            label: "First Name",
            value: resource.first_name,
            required: true
          ) %>
          <%= render Ui::InputComponent.new(
            name: "user[last_name]",
            label: "Last Name",
            value: resource.last_name,
            required: true
          ) %>
        </div>
      </div>

      <div>
        <h2 class="text-lg font-semibold mb-4">Email</h2>
        <%= render Ui::InputComponent.new(
          name: "user[email]",
          type: "email",
          label: "Email Address",
          value: resource.email,
          required: true
        ) %>
      </div>

      <div>
        <h2 class="text-lg font-semibold mb-4">Change Password</h2>
        <p class="text-sm text-[var(--color-muted-foreground)] mb-4">Leave blank if you don't want to change it</p>
        <div class="space-y-4">
          <%= render Ui::InputComponent.new(
            name: "user[password]",
            type: "password",
            label: "New Password",
            hint: "Minimum 6 characters",
            autocomplete: "new-password"
          ) %>
          <%= render Ui::InputComponent.new(
            name: "user[password_confirmation]",
            type: "password",
            label: "Confirm New Password",
            autocomplete: "new-password"
          ) %>
        </div>
      </div>

      <div class="border-t border-[var(--color-border)] pt-6">
        <%= render Ui::InputComponent.new(
          name: "user[current_password]",
          type: "password",
          label: "Current Password",
          hint: "Required to save changes",
          required: true,
          autocomplete: "current-password"
        ) %>
      </div>

      <div class="flex items-center justify-between">
        <%= render Ui::ButtonComponent.new(type: "submit") do %>Save Changes<% end %>
        <%= link_to "Cancel", profile_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
      </div>
    <% end %>
  <% end %>

  <div class="mt-8">
    <%= render Ui::CardComponent.new do %>
      <h2 class="text-lg font-semibold text-[var(--color-destructive)] mb-2">Delete Account</h2>
      <p class="text-sm text-[var(--color-muted-foreground)] mb-4">
        Once you delete your account, all of your data will be permanently removed. This action cannot be undone.
      </p>
      <%= render Ui::ButtonComponent.new(
        variant: :destructive,
        href: registration_path(resource_name),
        method: :delete,
        data: { turbo_confirm: "Are you sure? This action cannot be undone." }
      ) do %>Delete My Account<% end %>
    <% end %>
  </div>
</div>

<h1 style="margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #0f172a;">Welcome to <%= studio_name %>!</h1>
<p style="margin: 0 0 24px 0; font-size: 15px; color: #64748b; line-height: 1.5;">Hi <%= @user.first_name %>, we're thrilled to have you. Here's a quick guide to get started.</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom: 24px;">
  <tr>
    <td style="padding: 16px 20px; background-color: #f8fafc; border-radius: 8px; border: 1px solid #e2e8f0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
        <tr>
          <td style="padding: 8px 0;">
            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 50%; background-color: #6F7C4E; color: #ffffff; text-align: center; line-height: 24px; font-size: 13px; font-weight: 600; margin-right: 12px; vertical-align: middle;">1</span>
            <span style="font-size: 14px; color: #0f172a; font-weight: 500; vertical-align: middle;">Purchase a class package or subscription</span>
          </td>
        </tr>
        <tr>
          <td style="padding: 8px 0;">
            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 50%; background-color: #6F7C4E; color: #ffffff; text-align: center; line-height: 24px; font-size: 13px; font-weight: 600; margin-right: 12px; vertical-align: middle;">2</span>
            <span style="font-size: 14px; color: #0f172a; font-weight: 500; vertical-align: middle;">Browse the schedule and reserve a class</span>
          </td>
        </tr>
        <tr>
          <td style="padding: 8px 0;">
            <span style="display: inline-block; width: 24px; height: 24px; border-radius: 50%; background-color: #6F7C4E; color: #ffffff; text-align: center; line-height: 24px; font-size: 13px; font-weight: 600; margin-right: 12px; vertical-align: middle;">3</span>
            <span style="font-size: 14px; color: #0f172a; font-weight: 500; vertical-align: middle;">Show up and enjoy your class!</span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<%= email_button("Browse Classes", classes_url) %>

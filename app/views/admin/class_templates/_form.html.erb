<%= form_with(model: [:admin, class_template], class: "space-y-5") do |f| %>
  <% if class_template.errors.any? %>
    <div class="p-4 rounded-lg bg-red-50 text-red-700 text-sm">
      <ul class="list-disc pl-5 space-y-1">
        <% class_template.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_field :name, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :category_id, "Category", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.collection_select :category_id, @categories, :id, :name, { prompt: "Select" }, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :level, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.select :level, %w[beginner intermediate advanced all_levels].map { |l| [l.titleize, l] }, {}, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
  </div>

  <div>
    <%= f.label :description, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full px-3 py-2 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :default_duration, "Default Duration (min)", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :default_duration, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :default_capacity, "Default Capacity", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :default_capacity, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
  </div>

  <div class="border-t border-[var(--color-border)] pt-5 mt-2">
    <h3 class="text-sm font-semibold text-[var(--color-foreground)] mb-4">Weekly Schedule (optional)</h3>
    <p class="text-xs text-[var(--color-muted-foreground)] mb-4">Set a day, time, and teacher to automatically generate classes.</p>

    <div class="grid grid-cols-3 gap-4">
      <div>
        <%= f.label :day_of_week, "Day of Week", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
        <%= f.select :day_of_week, ClassTemplate::DAY_NAMES.each_with_index.map { |d, i| [d, i] }, { include_blank: "None" }, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      </div>
      <div>
        <%= f.label :default_start_time, "Start Time", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
        <%= f.time_field :default_start_time, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      </div>
      <div>
        <%= f.label :teacher_id, "Teacher", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
        <%= f.collection_select :teacher_id, @teachers, :id, :full_name, { include_blank: "Select" }, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-3">
    <%= f.check_box :active, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
    <%= f.label :active, "Active", class: "text-sm font-medium text-[var(--color-foreground)]" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_class_templates_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
  </div>
<% end %>

<% content_for(:page_title) { @user.full_name } %>

<div class="max-w-4xl">
  <div class="flex items-center justify-between mb-6">
    <%= link_to "&larr; Back to Users".html_safe, admin_users_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
    <%= link_to "Edit User", edit_admin_user_path(@user), class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" %>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
    <div class="flex items-center gap-4 mb-6">
      <% if @user.photo.attached? %>
        <%= render Ui::AvatarComponent.new(name: @user.full_name, src: url_for(@user.photo.variant(resize_to_fill: [128, 128])), size: :xl) %>
      <% else %>
        <div class="h-16 w-16 rounded-full bg-[var(--color-primary)]/10 flex items-center justify-center">
          <span class="text-xl font-medium text-[var(--color-primary)]"><%= @user.first_name[0] %><%= @user.last_name[0] %></span>
        </div>
      <% end %>
      <div>
        <h2 class="text-xl font-bold"><%= @user.full_name %></h2>
        <p class="text-[var(--color-muted-foreground)]"><%= @user.email %></p>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <p class="text-[var(--color-muted-foreground)]">Role</p>
        <p class="font-medium"><%= @user.role.titleize %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Status</p>
        <p class="font-medium"><%= @user.active? ? "Active" : "Inactive" %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Phone</p>
        <p class="font-medium"><%= @user.phone.presence || "—" %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Joined</p>
        <p class="font-medium"><%= @user.created_at.strftime("%B %d, %Y") %></p>
      </div>
    </div>
  </div>

  <% if @user.teacher? %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
      <h3 class="font-semibold mb-4">Teacher Profile</h3>
      <div class="space-y-4 text-sm">
        <% if @user.styles_list.any? %>
          <div>
            <p class="text-[var(--color-muted-foreground)] mb-1">Styles Taught</p>
            <div class="flex flex-wrap gap-2">
              <% @user.styles_list.each do |style| %>
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-[var(--color-primary)]/10 text-[var(--color-primary)]"><%= style %></span>
              <% end %>
            </div>
          </div>
        <% end %>
        <% if @user.bio.present? %>
          <div>
            <p class="text-[var(--color-muted-foreground)] mb-1">Bio</p>
            <p class="text-[var(--color-foreground)] whitespace-pre-line"><%= @user.bio %></p>
          </div>
        <% end %>
        <div>
          <p class="text-[var(--color-muted-foreground)] mb-1">Upcoming Classes</p>
          <p class="font-medium"><%= @user.teaching_classes.scheduled.where("date >= ?", Date.current).count %> scheduled</p>
        </div>
      </div>
    </div>
  <% end %>

  <% if @user.student? %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
        <p class="text-sm text-[var(--color-muted-foreground)]">Active Package</p>
        <% ap = @user.active_package %>
        <p class="text-lg font-bold mt-1"><%= ap ? "#{ap.credits_remaining} credits" : "None" %></p>
        <% if ap %>
          <p class="text-xs text-[var(--color-muted-foreground)]"><%= ap.package.name %> — expires <%= ap.expires_at.strftime("%b %d") %></p>
        <% end %>
      </div>
      <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
        <p class="text-sm text-[var(--color-muted-foreground)]">Subscription</p>
        <p class="text-lg font-bold mt-1"><%= @user.active_subscription ? "Active" : "None" %></p>
        <% if @user.active_subscription %>
          <p class="text-xs text-[var(--color-muted-foreground)]"><%= @user.active_subscription.subscription_plan.name %></p>
        <% end %>
      </div>
      <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
        <p class="text-sm text-[var(--color-muted-foreground)]">Total Reservations</p>
        <p class="text-lg font-bold mt-1"><%= @user.reservations.count %></p>
      </div>
    </div>

    <!-- Sell Package -->
    <% if @packages.any? %>
      <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
        <h3 class="font-semibold mb-4">Sell Package</h3>
        <%= form_with url: sell_package_admin_user_path(@user), method: :post, data: { turbo: false }, class: "flex items-end gap-3 flex-wrap" do %>
          <div class="flex-1 min-w-[200px]">
            <label class="block text-xs font-medium text-[var(--color-muted-foreground)] mb-1">Package</label>
            <select name="package_id" required class="w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]">
              <% @packages.each do |pkg| %>
                <option value="<%= pkg.id %>"><%= pkg.name %> — <%= number_to_currency(pkg.price) %> (<%= pkg.credit_count %> credits)</option>
              <% end %>
            </select>
          </div>
          <div class="min-w-[160px]">
            <label class="block text-xs font-medium text-[var(--color-muted-foreground)] mb-1">Payment method</label>
            <select name="payment_method" required class="w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]">
              <option value="cash">Cash</option>
              <option value="card_in_person">Card (in person)</option>
            </select>
          </div>
          <button type="submit" class="h-10 inline-flex items-center px-4 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer">
            Sell Package
          </button>
        <% end %>
      </div>
    <% end %>

    <% recent_reservations = @user.reservations.includes(studio_class: :class_template).order(created_at: :desc).limit(10) %>
    <% if recent_reservations.any? %>
      <div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden mb-6">
        <div class="px-5 py-4 border-b border-[var(--color-border)]">
          <h3 class="font-semibold">Recent Reservations</h3>
        </div>
        <div class="divide-y divide-[var(--color-border)]">
          <% recent_reservations.each do |r| %>
            <div class="flex items-center justify-between px-5 py-3 text-sm">
              <div>
                <p class="font-medium"><%= r.studio_class.name %></p>
                <p class="text-xs text-[var(--color-muted-foreground)]"><%= r.studio_class.date.strftime("%b %d, %Y") %> at <%= r.studio_class.start_time.strftime("%l:%M %p").strip %></p>
              </div>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                          <%= case r.status; when 'confirmed' then 'bg-emerald-50 text-emerald-700'; when 'cancelled' then 'bg-red-50 text-red-700'; when 'completed' then 'bg-blue-50 text-blue-700'; else 'bg-gray-100 text-gray-700'; end %>">
                <%= r.status.titleize %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>

  <!-- Purchase History -->
  <% if @payments.any? %>
    <div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
      <div class="px-5 py-4 border-b border-[var(--color-border)]">
        <h3 class="font-semibold">Purchase History</h3>
      </div>
      <div class="divide-y divide-[var(--color-border)]">
        <% @payments.each do |payment| %>
          <div class="flex items-center justify-between px-5 py-3 text-sm">
            <div class="flex items-center gap-3">
              <div class="h-8 w-8 rounded-lg flex items-center justify-center
                          <%= payment.status == 'succeeded' ? 'bg-emerald-50' : 'bg-gray-50' %>">
                <svg class="h-4 w-4 <%= payment.status == 'succeeded' ? 'text-emerald-600' : 'text-gray-400' %>"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                </svg>
              </div>
              <div>
                <p class="font-medium"><%= payment.description.presence || "Payment" %></p>
                <p class="text-xs text-[var(--color-muted-foreground)]">
                  <%= payment.created_at.strftime("%b %d, %Y") %>
                  &middot; <%= payment.payment_method.to_s.titleize.gsub("_", " ") %>
                </p>
              </div>
            </div>
            <div class="text-right">
              <p class="font-semibold">$<%= number_with_precision(payment.amount, precision: 2) %> <%= payment.currency.upcase %></p>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
                           <%= case payment.status
                               when 'succeeded' then 'bg-emerald-50 text-emerald-700'
                               when 'pending'   then 'bg-amber-50 text-amber-700'
                               when 'failed'    then 'bg-red-50 text-red-700'
                               when 'refunded'  then 'bg-gray-100 text-gray-600'
                               end %>">
                <%= payment.status.titleize %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%= form_with(model: [:admin, subscription_plan], class: "space-y-5") do |f| %>
  <% if subscription_plan.errors.any? %>
    <div class="p-4 rounded-lg bg-red-50 text-red-700 text-sm">
      <ul class="list-disc pl-5 space-y-1"><% subscription_plan.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul>
    </div>
  <% end %>
  <div>
    <%= f.label :name, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_field :name, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :price, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.number_field :price, step: 0.01, min: 0, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
    <div>
      <%= f.label :interval, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
      <%= f.select :interval, [["Monthly", "monthly"], ["Annual", "annual"]], {}, class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    </div>
  </div>
  <div>
    <%= f.label :stripe_price_id, "Stripe Price ID", class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_field :stripe_price_id, placeholder: "price_...", class: "w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm font-mono focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
    <p class="text-xs text-[var(--color-muted-foreground)] mt-1">Optional — will be created automatically in Stripe on first checkout if left blank.</p>
  </div>
  <div>
    <%= f.label :description, class: "block text-sm font-medium text-[var(--color-foreground)] mb-1" %>
    <%= f.text_area :description, rows: 3, class: "w-full px-3 py-2 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]" %>
  </div>
  <div class="flex items-center gap-2">
    <%= f.check_box :active, class: "h-4 w-4 rounded border-[var(--color-border)] text-[var(--color-primary)] focus:ring-[var(--color-primary)]" %>
    <%= f.label :active, "Active", class: "text-sm font-medium text-[var(--color-foreground)]" %>
  </div>
  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer" %>
    <%= link_to "Cancel", admin_subscription_plans_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
  </div>
<% end %>

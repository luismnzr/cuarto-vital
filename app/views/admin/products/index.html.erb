<% content_for(:page_title) { "Products" } %>
<div class="flex items-center justify-between mb-6">
  <h2 class="text-lg font-semibold">Products</h2>
  <%= link_to new_admin_product_path, class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
    Add Product
  <% end %>
</div>

<div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
  <table class="w-full divide-y divide-[var(--color-border)]">
    <thead class="bg-[var(--color-muted)]/50">
      <tr>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Product</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Price</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Stock</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Status</th>
        <th class="px-5 py-3 text-right text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[var(--color-border)]">
      <% @products.each do |product| %>
        <tr class="hover:bg-[var(--color-muted)]/30">
          <td class="px-5 py-3.5">
            <div class="flex items-center gap-3">
              <% if product.image.attached? %>
                <%= image_tag product.image.variant(resize_to_fill: [40, 40]), class: "h-10 w-10 rounded-lg object-cover" %>
              <% else %>
                <div class="h-10 w-10 rounded-lg bg-[var(--color-muted)] flex items-center justify-center">
                  <svg class="h-5 w-5 text-[var(--color-muted-foreground)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                </div>
              <% end %>
              <div>
                <p class="text-sm font-medium text-[var(--color-foreground)]"><%= product.name %></p>
                <% if product.description.present? %>
                  <p class="text-xs text-[var(--color-muted-foreground)] truncate max-w-xs"><%= product.description %></p>
                <% end %>
              </div>
            </div>
          </td>
          <td class="px-5 py-3.5 text-sm text-[var(--color-foreground)]"><%= number_to_currency(product.price) %></td>
          <td class="px-5 py-3.5 text-sm">
            <% if product.stock_quantity > 0 %>
              <span class="text-[var(--color-foreground)]"><%= product.stock_quantity %> in stock</span>
            <% else %>
              <span class="text-[var(--color-destructive)]">Out of stock</span>
            <% end %>
          </td>
          <td class="px-5 py-3.5">
            <% if product.active? %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">Active</span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Inactive</span>
            <% end %>
          </td>
          <td class="px-5 py-3.5 text-right">
            <div class="flex items-center justify-end gap-2">
              <%= link_to edit_admin_product_path(product), class: "text-sm text-[var(--color-primary)] hover:text-[var(--color-primary-hover)] font-medium" do %>Edit<% end %>
              <%= button_to admin_product_path(product), method: :delete,
                    data: { turbo_confirm: "Are you sure? This will #{product.order_items.exists? ? 'deactivate' : 'delete'} this product." },
                    class: "text-sm text-[var(--color-destructive)] hover:text-[var(--color-destructive)]/80 font-medium cursor-pointer" do %>
                <%= product.order_items.exists? ? "Deactivate" : "Delete" %>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @products.empty? %>
    <div class="px-5 py-10 text-center">
      <p class="text-sm text-[var(--color-muted-foreground)]">No products yet. Add your first product to start selling.</p>
    </div>
  <% end %>
</div>

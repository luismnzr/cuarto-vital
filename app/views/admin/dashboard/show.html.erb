<% content_for(:page_title) { "Dashboard" } %>

<!-- Stats cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Total Students</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @total_students %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-gray-100 flex items-center justify-center">
        <svg class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Total Teachers</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @total_teachers %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-gray-100 flex items-center justify-center">
        <svg class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Classes Today</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @classes_today %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-emerald-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-[var(--color-success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
    </div>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Bookings Today</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @reservations_today %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-amber-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-[var(--color-warning)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
      </div>
    </div>
  </div>
</div>

<!-- Revenue + Subscriptions row -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-8">
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Revenue This Month</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= number_to_currency(@revenue_this_month) %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-emerald-50 flex items-center justify-center">
        <svg class="h-5 w-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
    </div>
  </div>
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-5">
    <div class="flex items-center justify-between">
      <div>
        <p class="text-sm font-medium text-[var(--color-muted-foreground)]">Active Subscriptions</p>
        <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @active_subscriptions %></p>
      </div>
      <div class="h-10 w-10 rounded-lg bg-gray-100 flex items-center justify-center">
        <svg class="h-5 w-5 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
      </div>
    </div>
  </div>
</div>

<!-- Weekly Activity Chart -->
<div class="bg-white rounded-xl border border-[var(--color-border)] p-5 mb-8">
  <h2 class="font-semibold text-[var(--color-foreground)] mb-4">This Week's Activity</h2>
  <div class="flex items-end gap-3 h-40">
    <% max_val = [@weekly_classes.map { |d| d[:bookings] }.max || 1, 1].max %>
    <% @weekly_classes.each do |day| %>
      <div class="flex-1 flex flex-col items-center gap-1">
        <div class="w-full flex flex-col items-center justify-end h-28">
          <% bar_height = max_val > 0 ? (day[:bookings].to_f / max_val * 100).round : 0 %>
          <span class="text-xs font-medium text-[var(--color-foreground)] mb-1"><%= day[:bookings] %></span>
          <div class="w-full max-w-[2rem] rounded-t-md <%= day[:date] == Date.current ? 'bg-[var(--color-primary)]' : 'bg-[var(--color-primary)]/40' %>" style="height: <%= [bar_height, 4].max %>%"></div>
        </div>
        <span class="text-xs text-[var(--color-muted-foreground)] font-medium <%= day[:date] == Date.current ? 'text-[var(--color-primary)] font-semibold' : '' %>"><%= day[:label] %></span>
        <span class="text-[10px] text-[var(--color-muted-foreground)]"><%= day[:classes] %> cls</span>
      </div>
    <% end %>
  </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <!-- Today's Classes -->
  <div class="bg-white rounded-xl border border-[var(--color-border)]">
    <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--color-border)]">
      <h2 class="font-semibold text-[var(--color-foreground)]">Today's Classes</h2>
      <%= link_to "View all", admin_classes_path, class: "text-sm text-[var(--color-primary)] font-medium hover:text-[var(--color-primary-hover)]" %>
    </div>
    <% todays_classes = StudioClass.where(date: Date.current).includes(:class_template, :teacher).order(:start_time) %>
    <% if todays_classes.any? %>
      <div class="divide-y divide-[var(--color-border)]">
        <% todays_classes.limit(6).each do |sc| %>
          <div class="flex items-center gap-4 px-5 py-3.5">
            <div class="flex-shrink-0 text-center w-12">
              <p class="text-sm font-semibold text-[var(--color-foreground)]"><%= sc.start_time.strftime("%l:%M").strip %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]"><%= sc.start_time.strftime("%p") %></p>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-[var(--color-foreground)] truncate"><%= sc.name %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]"><%= sc.teacher.full_name %></p>
            </div>
            <div class="text-right">
              <p class="text-sm font-medium text-[var(--color-foreground)]"><%= sc.capacity - sc.spots_remaining %>/<%= sc.capacity %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]">booked</p>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-5 py-10 text-center">
        <p class="text-sm text-[var(--color-muted-foreground)]">No classes scheduled for today</p>
      </div>
    <% end %>
  </div>

  <!-- Recent Bookings -->
  <div class="bg-white rounded-xl border border-[var(--color-border)]">
    <div class="flex items-center justify-between px-5 py-4 border-b border-[var(--color-border)]">
      <h2 class="font-semibold text-[var(--color-foreground)]">Recent Bookings</h2>
      <%= link_to "View all", admin_reservations_path, class: "text-sm text-[var(--color-primary)] font-medium hover:text-[var(--color-primary-hover)]" %>
    </div>
    <% if @recent_reservations.any? %>
      <div class="divide-y divide-[var(--color-border)]">
        <% @recent_reservations.each do |r| %>
          <div class="flex items-center gap-4 px-5 py-3.5">
            <div class="flex-shrink-0 h-9 w-9 rounded-full bg-[var(--color-primary)]/10 flex items-center justify-center">
              <span class="text-xs font-medium text-[var(--color-primary)]"><%= r.user.first_name[0] %><%= r.user.last_name[0] %></span>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-[var(--color-foreground)] truncate"><%= r.user.full_name %></p>
              <p class="text-xs text-[var(--color-muted-foreground)]"><%= r.studio_class.name %></p>
            </div>
            <div class="text-right">
              <p class="text-xs text-[var(--color-muted-foreground)]"><%= time_ago_in_words(r.created_at) %> ago</p>
              <span class="inline-flex items-center px-1.5 py-0.5 rounded text-xs font-medium
                          <%= r.status == 'confirmed' ? 'bg-emerald-50 text-emerald-700' : 'bg-amber-50 text-amber-700' %>">
                <%= r.status.capitalize %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-5 py-10 text-center">
        <p class="text-sm text-[var(--color-muted-foreground)]">No recent bookings</p>
      </div>
    <% end %>
  </div>
</div>

<% content_for(:page_title) { "Order ##{@order.id}" } %>
<div class="max-w-3xl">
  <%= link_to "&larr; Back to Orders".html_safe, admin_orders_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)] mb-4 inline-block" %>

  <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-lg font-semibold">Order #<%= @order.id %></h2>
      <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium
                  <%= case @order.status; when 'completed' then 'bg-emerald-50 text-emerald-700'; when 'pending' then 'bg-amber-50 text-amber-700'; when 'cancelled' then 'bg-red-50 text-red-700'; end %>">
        <%= @order.status.titleize %>
      </span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm mb-6">
      <div>
        <p class="text-[var(--color-muted-foreground)]">Customer</p>
        <p class="font-medium"><%= @order.user&.full_name || "Walk-in" %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Payment Method</p>
        <p class="font-medium"><%= @order.payment_method.titleize %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Date</p>
        <p class="font-medium"><%= @order.created_at.strftime("%B %d, %Y %l:%M %p") %></p>
      </div>
      <div>
        <p class="text-[var(--color-muted-foreground)]">Total</p>
        <p class="text-lg font-bold"><%= number_to_currency(@order.total) %></p>
      </div>
    </div>

    <% if @order.notes.present? %>
      <div class="text-sm mb-6">
        <p class="text-[var(--color-muted-foreground)]">Notes</p>
        <p class="mt-1"><%= @order.notes %></p>
      </div>
    <% end %>
  </div>

  <div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
    <div class="px-5 py-4 border-b border-[var(--color-border)]">
      <h3 class="font-semibold">Items</h3>
    </div>
    <table class="w-full divide-y divide-[var(--color-border)]">
      <thead class="bg-[var(--color-muted)]/50">
        <tr>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Product</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Unit Price</th>
          <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Qty</th>
          <th class="px-5 py-3 text-right text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Subtotal</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--color-border)]">
        <% @order.order_items.each do |item| %>
          <tr>
            <td class="px-5 py-3.5 text-sm font-medium text-[var(--color-foreground)]"><%= item.product.name %></td>
            <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]"><%= number_to_currency(item.unit_price) %></td>
            <td class="px-5 py-3.5 text-sm text-[var(--color-muted-foreground)]"><%= item.quantity %></td>
            <td class="px-5 py-3.5 text-sm font-medium text-[var(--color-foreground)] text-right"><%= number_to_currency(item.quantity * item.unit_price) %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr class="bg-[var(--color-muted)]/30">
          <td colspan="3" class="px-5 py-3 text-sm font-semibold text-right">Total</td>
          <td class="px-5 py-3 text-sm font-bold text-right"><%= number_to_currency(@order.total) %></td>
        </tr>
      </tfoot>
    </table>
  </div>
</div>

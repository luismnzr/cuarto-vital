<% content_for(:page_title) { @studio_class.name } %>

<div class="mb-6">
  <%= link_to "&larr; Back to Classes".html_safe, admin_classes_path, class: "text-sm text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]" %>
</div>

<!-- Class Info -->
<div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
  <div class="flex items-start justify-between">
    <div>
      <h2 class="text-xl font-bold"><%= @studio_class.name %></h2>
      <p class="text-sm text-[var(--color-muted-foreground)] mt-1">
        <%= @studio_class.date.strftime("%A, %B %d, %Y") %> &middot;
        <%= @studio_class.start_time.strftime("%l:%M %p").strip %> — <%= @studio_class.end_time.strftime("%l:%M %p").strip %> &middot;
        <%= @studio_class.teacher.full_name %>
      </p>
    </div>
    <div class="text-right">
      <p class="text-2xl font-bold"><%= @studio_class.capacity - @studio_class.spots_remaining %> / <%= @studio_class.capacity %></p>
      <p class="text-xs text-[var(--color-muted-foreground)]"><%= @studio_class.spots_remaining %> spots remaining</p>
    </div>
  </div>
</div>

<!-- Check In User -->
<% unless @studio_class.full? || @studio_class.status == "cancelled" %>
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-6 mb-6">
    <h3 class="text-sm font-semibold mb-4">Check In Student</h3>

    <%= form_with url: admin_class_checkins_path(@studio_class), method: :post, data: { turbo: false }, id: "checkin-form", class: "space-y-4" do |f| %>
      <div>
        <label class="block text-sm font-medium text-[var(--color-foreground)] mb-1">Student</label>
        <select name="user_id" id="checkin-user-select" required
                class="w-full h-10 px-3 rounded-lg border border-[var(--color-border)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--color-primary)]"
                onchange="handleUserSelect(this)">
          <option value="">Select a student...</option>
          <% @students.each do |student| %>
            <%
              has_plan = student.can_reserve?
              plan_label = if student.has_active_subscription?
                "Unlimited subscription"
              elsif student.has_available_credits?
                "#{student.active_package.credits_remaining} credits"
              else
                "No active plan"
              end
            %>
            <option value="<%= student.id %>"
                    data-has-plan="<%= has_plan %>"
                    data-plan-label="<%= plan_label %>">
              <%= student.full_name %> (<%= student.email %>) — <%= plan_label %>
            </option>
          <% end %>
        </select>
      </div>

      <!-- Plan status indicator -->
      <div id="plan-status" class="hidden">
        <div id="plan-ok" class="hidden flex items-center gap-2 p-3 rounded-lg bg-emerald-50 text-emerald-700 text-sm">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span id="plan-ok-text"></span>
        </div>
        <div id="plan-none" class="hidden p-3 rounded-lg bg-amber-50 text-amber-700 text-sm">
          <p class="font-medium mb-2">No active plan — sell a package for in-person check-in:</p>
          <div class="space-y-3">
            <div>
              <label class="block text-xs font-medium mb-1">Package</label>
              <select name="package_id" id="walkin-package"
                      class="w-full h-10 px-3 rounded-lg border border-amber-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
                <% @packages.each do |pkg| %>
                  <option value="<%= pkg.id %>"><%= pkg.name %> — <%= number_to_currency(pkg.price) %> (<%= pkg.credit_count %> credits)</option>
                <% end %>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium mb-1">Payment method</label>
              <select name="payment_method" id="walkin-payment-method"
                      class="w-full h-10 px-3 rounded-lg border border-amber-200 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-amber-400">
                <option value="cash">Cash</option>
                <option value="card_in_person">Card (in person)</option>
              </select>
            </div>
            <input type="hidden" name="walk_in" id="walkin-flag" value="0">
          </div>
        </div>
      </div>

      <div>
        <button type="submit" id="checkin-submit" disabled
                class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-[var(--color-primary)] rounded-lg hover:bg-[var(--color-primary-hover)] transition-colors cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
          Check In
        </button>
      </div>
    <% end %>
  </div>
<% end %>

<!-- Roster -->
<div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden mb-6">
  <div class="px-5 py-3 border-b border-[var(--color-border)]">
    <h3 class="text-sm font-semibold">Class Roster</h3>
  </div>
  <% if @reservations.any? %>
    <table class="w-full text-sm">
      <thead class="bg-[var(--color-muted)]/50">
        <tr>
          <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Student</th>
          <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Email</th>
          <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Status</th>
          <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Booked</th>
          <th class="px-5 py-3 text-right font-medium text-[var(--color-muted-foreground)]">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--color-border)]">
        <% @reservations.each do |reservation| %>
          <tr class="hover:bg-[var(--color-muted)]/30">
            <td class="px-5 py-3.5 font-medium"><%= reservation.user.full_name %></td>
            <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]"><%= reservation.user.email %></td>
            <td class="px-5 py-3.5">
              <% variant = case reservation.status
                           when "confirmed" then :success
                           when "completed" then :success
                           when "no_show" then :destructive
                           else :secondary
                           end %>
              <%= render Ui::BadgeComponent.new(text: reservation.status.titleize, variant: variant) %>
            </td>
            <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]"><%= reservation.created_at.strftime("%b %d, %l:%M %p") %></td>
            <td class="px-5 py-3.5 text-right">
              <% if reservation.status == "confirmed" %>
                <button type="button" onclick="openRemoveModal('<%= reservation.user.full_name %>', '<%= admin_class_remove_student_path(@studio_class, reservation_id: reservation.id) %>')"
                        class="text-red-600 hover:underline text-sm font-medium">Remove</button>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="px-5 py-10 text-center">
      <p class="text-sm text-[var(--color-muted-foreground)]">No students checked in yet.</p>
    </div>
  <% end %>
</div>

<!-- Waitlist Roster -->
<% if @waitlist_entries.any? %>
  <div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
    <div class="px-5 py-3 border-b border-[var(--color-border)]">
      <h3 class="text-sm font-semibold">Waitlist (<%= @waitlist_entries.size %>)</h3>
    </div>
    <table class="w-full text-sm">
      <thead class="bg-[var(--color-muted)]/50">
        <tr>
          <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">#</th>
          <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Student</th>
          <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Email</th>
          <th class="px-5 py-3 text-left font-medium text-[var(--color-muted-foreground)]">Joined</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--color-border)]">
        <% @waitlist_entries.each do |entry| %>
          <tr class="hover:bg-[var(--color-muted)]/30">
            <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]"><%= entry.position %></td>
            <td class="px-5 py-3.5 font-medium"><%= entry.user.full_name %></td>
            <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]"><%= entry.user.email %></td>
            <td class="px-5 py-3.5 text-[var(--color-muted-foreground)]"><%= entry.joined_at.strftime("%b %d, %l:%M %p") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>

<!-- Remove Student Modal -->
<div id="remove-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center">
  <div class="absolute inset-0 bg-black/40" onclick="closeRemoveModal()"></div>
  <div class="relative bg-white rounded-xl border border-[var(--color-border)] shadow-xl w-full max-w-sm p-6">
    <h3 class="text-base font-semibold text-[var(--color-foreground)] mb-1">Remove Student</h3>
    <p class="text-sm text-[var(--color-muted-foreground)] mb-5">Remove <span id="remove-modal-name" class="font-medium text-[var(--color-foreground)]"></span> from this class. Should the credit be returned?</p>
    <div class="space-y-3">
      <form id="remove-return-form" method="post">
        <input type="hidden" name="_method" value="delete">
        <input type="hidden" name="return_credit" value="1">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-full border border-emerald-200 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition-colors cursor-pointer">
          <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          Remove & Return Credit
        </button>
      </form>
      <form id="remove-forfeit-form" method="post">
        <input type="hidden" name="_method" value="delete">
        <input type="hidden" name="return_credit" value="0">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>">
        <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-4 py-2 text-sm font-medium rounded-full border border-red-200 bg-red-50 text-red-700 hover:bg-red-100 transition-colors cursor-pointer">
          <svg class="h-4 w-4 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/></svg>
          Remove & Forfeit Credit
        </button>
      </form>
    </div>
    <button type="button" onclick="closeRemoveModal()" class="mt-4 w-full px-4 py-2 text-sm text-[var(--color-muted-foreground)] hover:bg-[var(--color-muted)] rounded-full transition-colors">Cancel</button>
  </div>
</div>

<script>
  function openRemoveModal(name, basePath) {
    document.getElementById('remove-modal-name').textContent = name;
    document.getElementById('remove-return-form').action = basePath + '?return_credit=1';
    document.getElementById('remove-forfeit-form').action = basePath + '?return_credit=0';
    document.getElementById('remove-modal').classList.remove('hidden');
  }

  function closeRemoveModal() {
    document.getElementById('remove-modal').classList.add('hidden');
  }

  // Close modal on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeRemoveModal();
  });

  function handleUserSelect(select) {
    var option = select.options[select.selectedIndex];
    var planStatus = document.getElementById('plan-status');
    var planOk = document.getElementById('plan-ok');
    var planNone = document.getElementById('plan-none');
    var planOkText = document.getElementById('plan-ok-text');
    var walkinFlag = document.getElementById('walkin-flag');
    var submitBtn = document.getElementById('checkin-submit');

    if (!option.value) {
      planStatus.classList.add('hidden');
      submitBtn.disabled = true;
      return;
    }

    planStatus.classList.remove('hidden');
    submitBtn.disabled = false;

    if (option.dataset.hasPlan === 'true') {
      planOk.classList.remove('hidden');
      planNone.classList.add('hidden');
      planOkText.textContent = option.dataset.planLabel;
      walkinFlag.value = '0';
    } else {
      planOk.classList.add('hidden');
      planNone.classList.remove('hidden');
      walkinFlag.value = '1';
    }
  }
</script>

<% content_for(:page_title) { "Wellhub Bookings" } %>

<div class="flex items-center justify-between mb-6">
  <h2 class="text-lg font-semibold">Wellhub Bookings</h2>
  <%= link_to admin_wellhub_bookings_path(format: :csv, status: params[:status]),
        class: "inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-[var(--color-foreground)] bg-white border border-[var(--color-border)] rounded-lg hover:bg-[var(--color-muted)] transition-colors" do %>
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
    Export CSV
  <% end %>
</div>

<!-- Stats -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-4">
    <p class="text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Total</p>
    <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @stats[:total] %></p>
  </div>
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-4">
    <p class="text-xs font-medium text-emerald-600 uppercase tracking-wider">Accepted</p>
    <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @stats[:accepted] %></p>
  </div>
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-4">
    <p class="text-xs font-medium text-blue-600 uppercase tracking-wider">Checked In</p>
    <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @stats[:checked_in] %></p>
  </div>
  <div class="bg-white rounded-xl border border-[var(--color-border)] p-4">
    <p class="text-xs font-medium text-red-600 uppercase tracking-wider">Cancelled</p>
    <p class="text-2xl font-bold text-[var(--color-foreground)] mt-1"><%= @stats[:cancelled] %></p>
  </div>
</div>

<!-- Status filter tabs -->
<div class="flex items-center gap-1 mb-6 border-b border-[var(--color-border)]">
  <%= link_to "All", admin_wellhub_bookings_path, class: "px-4 py-2.5 text-sm font-medium border-b-2 transition-colors #{params[:status].blank? ? 'border-[var(--color-primary)] text-[var(--color-primary)]' : 'border-transparent text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]'}" %>
  <% %w[accepted pending checked_in rejected cancelled].each do |status| %>
    <%= link_to status.titleize, admin_wellhub_bookings_path(status: status), class: "px-4 py-2.5 text-sm font-medium border-b-2 transition-colors #{params[:status] == status ? 'border-[var(--color-primary)] text-[var(--color-primary)]' : 'border-transparent text-[var(--color-muted-foreground)] hover:text-[var(--color-foreground)]'}" %>
  <% end %>
</div>

<div class="bg-white rounded-xl border border-[var(--color-border)] overflow-hidden">
  <table class="w-full divide-y divide-[var(--color-border)]">
    <thead class="bg-[var(--color-muted)]/50">
      <tr>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Booking #</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Gympass ID</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Class</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Date & Time</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Status</th>
        <th class="px-5 py-3 text-left text-xs font-medium text-[var(--color-muted-foreground)] uppercase tracking-wider">Booked</th>
        <th class="px-5 py-3"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-[var(--color-border)]">
      <% @bookings.each do |b| %>
        <tr class="hover:bg-[var(--color-muted)]/30">
          <td class="px-5 py-3.5">
            <p class="text-sm font-mono font-medium text-[var(--color-foreground)]"><%= b.booking_number %></p>
          </td>
          <td class="px-5 py-3.5">
            <p class="text-sm font-mono text-[var(--color-muted-foreground)]"><%= b.gympass_id %></p>
          </td>
          <td class="px-5 py-3.5">
            <p class="text-sm font-medium text-[var(--color-foreground)]"><%= b.studio_class.name %></p>
            <p class="text-xs text-[var(--color-muted-foreground)]"><%= b.studio_class.teacher.full_name %></p>
          </td>
          <td class="px-5 py-3.5">
            <p class="text-sm text-[var(--color-foreground)]"><%= b.studio_class.date.strftime("%b %d, %Y") %></p>
            <p class="text-xs text-[var(--color-muted-foreground)]"><%= b.studio_class.start_time.strftime("%l:%M %p").strip %></p>
          </td>
          <td class="px-5 py-3.5">
            <% status_classes = case b.status
               when "accepted" then "bg-emerald-50 text-emerald-700"
               when "pending" then "bg-amber-50 text-amber-700"
               when "checked_in" then "bg-blue-50 text-blue-700"
               when "rejected" then "bg-red-50 text-red-700"
               when "cancelled" then "bg-gray-100 text-gray-600"
               else "bg-gray-100 text-gray-600"
               end %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= status_classes %>">
              <%= b.status.titleize %>
            </span>
          </td>
          <td class="px-5 py-3.5 text-xs text-[var(--color-muted-foreground)]">
            <%= b.booked_at ? time_ago_in_words(b.booked_at) + " ago" : "—" %>
          </td>
          <td class="px-5 py-3.5 text-right">
            <%= link_to "View", admin_wellhub_booking_path(b), class: "text-sm text-[var(--color-primary)] hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @bookings.empty? %>
    <div class="px-5 py-10 text-center">
      <svg class="mx-auto h-10 w-10 text-[var(--color-muted-foreground)]/40 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      <p class="text-sm text-[var(--color-muted-foreground)]">No Wellhub bookings found.</p>
    </div>
  <% end %>
</div>

<% if defined?(@pagy) && @pagy.pages > 1 %>
  <div class="mt-6 flex justify-center">
    <%== @pagy.series_nav %>
  </div>
<% end %>
